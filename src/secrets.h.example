// Copy to secrets.h (gitignored) and fill in with long random values.
// The build fails without it on purpose: no default passwords ship in this
// public repo.
#pragma once

// ArduinoOTA push password. `pio run -e T5-ePaper-S3-ota -t upload` reads it
// from the T5_OTA_PASSWORD environment variable.
#define OTA_PASSWORD "change-me"

// HTTP Basic auth for the web UI and every /api/* route (setup/AP mode excluded).
#define WEB_USER     "admin"
#define WEB_PASSWORD "change-me-too"
